@page "/createexitslip"
@using global::MyFeedback.UI.TypedClients.Interfaces
@using global::Shared
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@inject NavigationManager _navigationManager
@rendermode InteractiveServer

<PageTitle>Opret ny exit slip</PageTitle>

<h3>Opret ny exit slip</h3>

<select @bind="@CreateExitSlipDtoPage.LessonId" asp-items="@(new SelectList(LessonIdList))">
    <option>Vælg lesson</option>
</select>

<input @bind="@CreateExitSlipDtoPage.LessonId" type="hidden" />
<input @bind="@LessonIdList" type="hidden" />

@for (int i = 0; i < CreateExitSlipDtoPage.QuestionList.Count(); i++)
{
    <div>
        <textarea @bind="CreateExitSlipDtoPage.QuestionList[i].QuestionText" rows="4" cols="50" maxlength="200" placeholder="Skriv dit spørgsmål her..."> </textarea>

        <input @bind="CreateExitSlipDtoPage.QuestionList[i].QuestionText" type="hidden" />

        createExitSlipRequestDto.QuestionList[i].QuestionNumber = i + 1;

        <input @bind="CreateExitSlipDtoPage.QuestionList[i].QuestionNumber" type="hidden" />
    </div>

    <br />
}

@if (CreateExitSlipDtoPage.QuestionList.Count() < 5)
{
    <button type="submit" onsubmit="AddQuestion" class="btn btn-dark">Tilføj nyt spørgsmål</button>

    <br />
}

<button type="submit" class="btn btn-info">Gem exit slip</button>


@code {

     // Injecter IExitSlipClient, s� man kan kalde dens metoder mod REST-API'en
    private readonly IExitSlipClient _exitSlipClient;

    private readonly ILessonClient _lessonClient;

    public CreateExitSlip(IExitSlipClient exitSlipClient, ILessonClient lessonClient, NavigationManager navigationManager)
    {
        // Constructor injections
        _exitSlipClient = exitSlipClient; 
        _lessonClient = lessonClient;
        _navigationManager = navigationManager;
        
        // Bind prop.s initialiseres
        this.CreateExitSlipDtoPage = new CreateExitSlipRequestDto();
        this.LessonIdList = new List<Guid>();
    }

    public CreateExitSlipRequestDto CreateExitSlipDtoPage { get; set; }
    public List<Guid> LessonIdList { get; set; }
    

    protected override void OnInitialized()
    {

        var tempDtoList = _lessonClient.GetAllLessons();

     //   LessonIdList = tempDtoList.ToList();


        if (CreateExitSlipDtoPage == null)
        {
            CreateExitSlipDtoPage = new CreateExitSlipRequestDto();

            CreateExitSlipDtoPage.QuestionList = new List<CreateQuestionRequestDto>();

            CreateExitSlipDtoPage.QuestionList.Add(new CreateQuestionRequestDto() { QuestionNumber = 1, QuestionText = "" });

        }
    }

    public void HandleValidSubmit()
    {
        _exitSlipClient.CreateExitSlip(CreateExitSlipDtoPage);
    }

    public void AddQuestion()
    {
        CreateExitSlipDtoPage.QuestionList.Add(new CreateQuestionRequestDto());
    }
    }
}