@page "/createforumpost"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Mvc;
@using Microsoft.AspNetCore.Mvc.RazorPages;
@using global::MyFeedback.Application.Command;
@using global::MyFeedback.Application.Command.CommandDto.ForumPost;
@using global::MyFeedback.Application.Query;
@using global::MyFeedback.Application.Query.QueryDto;
@using global::MyFeedback.Application.Command
@using Microsoft.AspNetCore.Components.Web
@using CategoryQueryDto = global::MyFeedback.Application.Query.QueryDto.CategoryQueryDto
@using CreateForumPostDto = global::MyFeedback.Application.Command.CommandDto.ForumPost.CreateForumPostDto
@using ForumPostQueryDto = global::MyFeedback.Application.Query.QueryDto.ForumPostQueryDto
@using ICategoryQuery = global::MyFeedback.Application.Query.ICategoryQuery
@using Microsoft.AspNetCore.Components.Web


<PageTitle>Opret forumindlæg></PageTitle>

    <h2>Opret forum-post</h2>

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="form-group">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                 
                    <input type="hidden" asp-for="ForumPostDto.CommentList" class="form-control" />

                    <select name="Category">

                        <option value="">Vælg et rum</option>

                        @* @foreach (var category in CategoryDtoList) *@
                        @* { *@
                        @*     <option value=@category.Id>@category.Name</option> *@
                        @* } *@
                     
                    </select>

                    <br />

                <label asp-for="ForumPostDto.ProblemText"></label>
                <input asp-for="ForumPostDto.ProblemText" class="form-control"/>
                <span asp-validation-for="ForumPostDto.ProblemText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ForumPostDto.SolutionText"></label>
                <input asp-for="ForumPostDto.SolutionText" class="form-control" />
                <span asp-validation-for="ForumPostDto.SolutionText" class="text-danger"></span>
            </div>

            <style>.btn {margin-top: 10px;} </style>

            <button type="submit" class="btn btn-info" >Opret</button>
        </form>
    </div>
</div>

}

