{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "backendCluster",
        "Match": {
          "Path": "/Backend/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backendCluster": {
        "Destinations": {
          "backendDestination": {
            "Address": "http://MyFeedback.Backend:8080/"
          }
        }
      }
    }
  }
}
